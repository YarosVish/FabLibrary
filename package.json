{
  "name": "fab-library",
  "productName": "Fab Library",
  "version": "1.0.0",
  "description": "Офлайн-каталог библиотеки Fab, Quixel и вишлиста",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "npx --yes electron-builder@25 --win portable"
  },
  "build": {
    "appId": "local.fablibrary",
    "productName": "Fab Library",
    "files": ["main.js", "preload.js", "sync.js", "quixel.js", "ui/**", "package.json"],
    "win": { "target": "portable" }
  },
  "devDependencies": { "electron": "^44.0.0" }
}
